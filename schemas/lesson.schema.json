{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScientificLesson v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lesson_id",
    "claim",
    "mechanism",
    "category",
    "status",
    "classification",
    "available_at",
    "version",
    "conditions",
    "limitations",
    "task_types",
    "case_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "research_strategy",
        "algorithm_strategy",
        "experimental_strategy",
        "publication_strategy"
      ]
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "REVIEWED",
        "CONFLICTED",
        "REFUTED"
      ]
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "PRIVATE"
      ]
    },
    "available_at": {
      "type": "string",
      "format": "date"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_ref": {
      "type": "string",
      "minLength": 1
    },
    "case_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "source_id",
          "sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "REVIEWED"
          }
        }
      },
      "then": {
        "required": [
          "review_ref"
        ]
      }
    }
  ]
}
