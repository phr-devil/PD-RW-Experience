{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LessonFeedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "lesson_id",
    "observation",
    "outcome",
    "observed_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "INCONCLUSIVE"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
