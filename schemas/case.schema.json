{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScientificCase v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "split",
    "classification",
    "available_at",
    "case_group",
    "research_question",
    "method",
    "observed_outcome",
    "limitations",
    "source_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_type": {
      "enum": [
        "paper",
        "success",
        "failure",
        "mixed"
      ]
    },
    "split": {
      "enum": [
        "TRAIN",
        "VAL",
        "TEST"
      ]
    },
    "classification": {
      "enum": [
        "PUBLIC",
        "PRIVATE"
      ]
    },
    "available_at": {
      "type": "string",
      "format": "date"
    },
    "case_group": {
      "type": "string",
      "minLength": 1
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "observed_outcome": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "sha256",
          "available_at",
          "visibility"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "available_at": {
            "type": "string",
            "format": "date"
          },
          "visibility": {
            "enum": [
              "PUBLIC",
              "PRIVATE"
            ]
          }
        }
      }
    },
    "reviewed_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "answer",
        "review_ref",
        "evaluation_type",
        "reviewed_at"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        },
        "evaluation_type": {
          "const": "NORMALIZED_FACT"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "accepted_answers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mirror_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mirror_manifest_sha256",
        "mirror_card_path",
        "mirror_card_sha256",
        "original_source_card_sha256",
        "original_source_ids",
        "original_source_refs",
        "evidence_grade",
        "source_type",
        "method_source_ref",
        "original_source_bytes_verified",
        "mirror_card_bytes_verified",
        "historical_visibility_verified"
      ],
      "properties": {
        "mirror_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mirror_card_path": {
          "type": "string",
          "minLength": 1
        },
        "mirror_card_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_source_card_sha256": {
          "type": "string",
          "minLength": 1
        },
        "original_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "original_source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_grade": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "method_source_ref": {
          "type": "string",
          "minLength": 1
        },
        "original_source_bytes_verified": {
          "const": false
        },
        "mirror_card_bytes_verified": {
          "const": true
        },
        "historical_visibility_verified": {
          "const": false
        }
      }
    }
  }
}
